# Demo-only shared credentials. Replace with strong, unique secrets before any hosted pilot.
LEARNFLEX_DEMO_STUDENT_PASSWORD=replace-with-a-unique-student-demo-password
LEARNFLEX_DEMO_TEACHER_PASSWORD=replace-with-a-unique-teacher-demo-password
# Public student self-registration is blocked in production unless the school approves onboarding.
LEARNFLEX_ALLOW_PUBLIC_STUDENT_REGISTRATION=false
LEARNFLEX_RETENTION_DAYS=365

# Set to the final public HTTPS origin so canonical, sitemap, robots and llms.txt URLs match deployment.
LEARNFLEX_PUBLIC_URL=https://your-final-domain.example
